  "type": "module",
  "version": "0.1.0",
  "packageManager": "pnpm@12.21.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check && eslint . && prettier --check .",
