---
import SignalSection from '~/components/SignalSection';
import SectionHead from '~/components/SectionHead.astro';

import { useDict, type Locale } from '~/i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useDict(locale);
---

<section id="signal" class="section" aria-labelledby="signal-title">
  <div class="container">
    <SectionHead
      num={4}
      label={t.sections.signal}
      id="signal-title"
      title={t.signal.title}
      lead={t.signal.body}
    />
    <SignalSection
      client:visible
      locale={locale}
      labels={{ ...t.signal, earth: t.explore.bodies.earth, v1: t.hero.v1, v2: t.hero.v2 }}
    />
  </div>
</section>
