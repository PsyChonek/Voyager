---
import LiveCounter from '~/components/LiveCounter';
import HeroScene from '~/scenes/HeroScene';
import live from '../../../public/data/live.json';
import { liveState, type LiveData } from '~/lib/live';
import { useDict, type Locale } from '~/i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useDict(locale);
const data = live as LiveData;
const now = Date.now();
const initial = { v1: liveState(data, 'v1', now), v2: liveState(data, 'v2', now) };
const words = t.hero.title.split(' ');
---

<section class="hero" aria-labelledby="hero-title">
  <div class="nebula" aria-hidden="true">
    <span></span>
    <span></span>
    <span></span>
  </div>
  <HeroScene client:idle label={t.hero.modelAlt} noWebgl={t.hero.noWebgl} />
  <div class="container hero-inner">
    <p class="kicker rise" style="--i:0">
      {t.hero.kicker}
    </p>
    <h1 id="hero-title">
      {words.map((w, i) => (
        <span class="word" style={`--i:${i + 1}`}>
          <span class={i === 0 ? 'grad' : undefined}>{w}</span>
        </span>
      ))}
    </h1>
    <p class="lead rise" style={`--i:${words.length + 1}`}>
      {t.hero.lead}
    </p>
    <div class="rise" style={`--i:${words.length + 2}`}>
      <LiveCounter
        client:load
        locale={locale}
        initial={initial}
        generated={data.generated}
        labels={{ ...t.hero, km: t.units.km, au: t.units.au, kms: t.units.kms }}
      />
    </div>
    <p class="milestone rise" style={`--i:${words.length + 3}`}>
      <span class="ping" aria-hidden="true"></span>
      {t.hero.milestone}
    </p>
    <a class="btn rise" style={`--i:${words.length + 4}`} href="#journey">
      {t.hero.scroll}
      <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true" class="arrow">
        <path d="M8 2v11M3 8l5 5 5-5" fill="none" stroke="currentColor" stroke-width="2"></path>
      </svg>
    </a>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    padding-block: 120px 72px;
    overflow: hidden;
    isolation: isolate;
  }
  .hero :global(.hero-canvas) {
    position: absolute;
    top: 0;
    right: 0;
    width: 60%;
    height: min(100svh, 980px);
    z-index: -1;
  }
  .nebula {
    position: absolute;
    inset: -20%;
    z-index: -2;
    pointer-events: none;
    filter: blur(60px);
    opacity: 0.55;
  }
  .nebula span {
    position: absolute;
    border-radius: 50%;
    animation: drift 26s ease-in-out infinite alternate;
  }
  .nebula span:nth-child(1) {
    width: 46vw;
    height: 46vw;
    right: 6%;
    top: 12%;
    background: radial-gradient(circle, rgb(255 140 60 / 0.35), transparent 65%);
  }
  .nebula span:nth-child(2) {
    width: 38vw;
    height: 38vw;
    right: 28%;
    top: 40%;
    background: radial-gradient(circle, rgb(120 90 255 / 0.28), transparent 65%);
    animation-duration: 32s;
  }
  .nebula span:nth-child(3) {
    width: 30vw;
    height: 30vw;
    left: 6%;
    top: 5%;
    background: radial-gradient(circle, rgb(94 200 255 / 0.18), transparent 65%);
    animation-duration: 38s;
  }
  @keyframes drift {
    to {
      transform: translate(6vw, -4vw) scale(1.15);
    }
  }
  .hero-inner {
    position: relative;
  }
  .hero .lead,
  .hero h1 {
    text-shadow: 0 2px 24px rgb(4 6 12 / 0.9);
  }
  .hero h1 {
    max-width: 14ch;
    margin-bottom: 0.4em;
  }
  .word {
    display: inline-block;
    margin-right: 0.24em;
    animation: rise 1s var(--ease-out) both;
    animation-delay: calc(var(--i) * 90ms + 150ms);
  }
  .rise {
    animation: rise 1s var(--ease-out) both;
    animation-delay: calc(var(--i) * 90ms + 150ms);
  }
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(0.6em) rotate(2deg);
      filter: blur(6px);
    }
  }
  .milestone {
    position: relative;
    max-width: 60ch;
    padding: 0.9rem 1rem 0.9rem 2.6rem;
    margin-block: 1.5rem;
    border-radius: 14px;
    background: rgb(255 181 71 / 0.07);
    border: 1px solid rgb(255 181 71 / 0.25);
  }
  .ping {
    position: absolute;
    left: 1rem;
    top: 1.35rem;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--accent);
  }
  .ping::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: 2px solid var(--accent);
    animation: ping 1.8s var(--ease-out) infinite;
  }
  @keyframes ping {
    to {
      transform: scale(3.2);
      opacity: 0;
    }
  }
  .arrow {
    animation: bob 1.6s ease-in-out infinite;
  }
  @keyframes bob {
    50% {
      transform: translateY(3px);
    }
  }
  @media (max-width: 900px) {
    .hero :global(.hero-canvas) {
      width: 55%;
      height: 60svh;
    }
  }
  @media (max-width: 600px) {
    .hero :global(.hero-canvas) {
      width: 100%;
      height: 50svh;
      opacity: 0.4;
    }
  }
</style>
