---
import { useDict, type Locale } from '~/i18n';

interface Props {
  locale: Locale;
}
const t = useDict(Astro.props.locale);
// The list is rendered twice so the CSS loop can scroll seamlessly.
---

<div class="ticker">
  <ul>
    {[0, 1].map((copy) =>
      t.ticker.map((f) => (
        <li aria-hidden={copy === 1 ? 'true' : undefined}>
          <strong>{f.value}</strong>
          <span>{f.label}</span>
        </li>
      )),
    )}
  </ul>
</div>
