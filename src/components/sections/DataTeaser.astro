---
import ScienceChart from '~/components/ScienceChart';
import SectionHead from '~/components/SectionHead.astro';

import { useDict, routes, type Locale } from '~/i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useDict(locale);
const chartLabels = {
  ...t.data.series,
  ...t.data.events,
  loading: t.data.loading,
  error: t.data.error,
};
---

<section class="section" aria-labelledby="teaser-title">
  <div class="container">
    <SectionHead
      num={3}
      label={t.sections.data}
      id="teaser-title"
      title={t.dataTeaser.title}
      lead={t.dataTeaser.body}
    />
    <figure class="panel" data-reveal="zoom">
      <ScienceChart client:visible kind="heliopauseV1" labels={chartLabels} locale={locale} />
      <figcaption class="muted">{t.data.heliopauseV1.desc}</figcaption>
    </figure>
    <a class="btn" href={routes.data[locale]}>
      {t.dataTeaser.cta}
    </a>
  </div>
</section>

<style>
  figure {
    margin: 2rem 0;
  }
  figcaption {
    margin-top: 1rem;
    font-size: 0.95rem;
  }
</style>
