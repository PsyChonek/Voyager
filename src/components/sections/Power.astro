---
import { useDict, type Locale } from '~/i18n';
import SectionHead from '~/components/SectionHead.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useDict(locale);
const p = t.power;

// Approximate model only: 470 W at launch, about 4 W lost per year.
const Y0 = 1977;
const Y1 = 2036;
const W = 600;
const H = 320;
const pad = { l: 56, r: 16, t: 44, b: 40 };
const x = (y: number) => pad.l + ((y - Y0) / (Y1 - Y0)) * (W - pad.l - pad.r);
const yv = (w: number) => pad.t + (1 - w / 500) * (H - pad.t - pad.b);
const power = (y: number) => 470 - 4 * (y - Y0);
const nowYear = new Date().getUTCFullYear() + new Date().getUTCMonth() / 12;
const past = `M ${x(Y0)} ${yv(power(Y0))} L ${x(nowYear)} ${yv(power(nowYear))}`;
const future = `M ${x(nowYear)} ${yv(power(nowYear))} L ${x(Y1)} ${yv(power(Y1))}`;
const area = `${past} L ${x(nowYear)} ${yv(0)} L ${x(Y0)} ${yv(0)} Z`;
const ticksX = [1980, 1990, 2000, 2010, 2020, 2030];
const ticksXMain = [1980, 2000, 2020];
const ticksY = [0, 100, 200, 300, 400, 500];
---

<section class="section" aria-labelledby="power-title">
  <div class="container grid">
    <div>
      <SectionHead
        num={5}
        label={t.sections.power}
        id="power-title"
        title={p.title}
        lead={p.body}
      />
      <ol class="events" data-reveal>
        {p.events.map((e, i) => (
          <li>
            <span class="marker" aria-hidden="true">
              {i + 1}
            </span>
            <span class="mono">{e.year}</span>
            <span>{e.text}</span>
          </li>
        ))}
      </ol>
    </div>
    <figure class="panel" data-reveal="zoom">
      <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-labelledby="power-svg-title">
        <title id="power-svg-title">{p.chartLabel}</title>
        <defs>
          <linearGradient id="power-fill" x1="0" x2="0" y1="0" y2="1">
            <stop offset="0" stop-color="#ffb547" stop-opacity="0.35"></stop>
            <stop offset="1" stop-color="#ffb547" stop-opacity="0"></stop>
          </linearGradient>
        </defs>
        <text x={pad.l} y="18" fill="#a3aec2" font-size="15">
          {p.watts}
        </text>
        {ticksY.map((w) => (
          <g>
            <line x1={pad.l} x2={W - pad.r} y1={yv(w)} y2={yv(w)} stroke="#1f2a44" />
            <text x={pad.l - 10} y={yv(w) + 5} text-anchor="end" fill="#a3aec2" font-size="14">
              {w}
            </text>
          </g>
        ))}
        {ticksX.map((y) => (
          <text
            x={x(y)}
            y={H - 14}
            text-anchor="middle"
            fill="#a3aec2"
            font-size="14"
            class={ticksXMain.includes(y) ? undefined : 'tick-minor'}
          >
            {y}
          </text>
        ))}
        <path d={area} fill="url(#power-fill)"></path>
        {p.events.map((e, i) => (
          <g>
            <line
              x1={x(e.year)}
              x2={x(e.year)}
              y1={pad.t}
              y2={H - pad.b}
              stroke="#ff7aa8"
              stroke-dasharray="3 4"
              opacity="0.55"
            />
            <circle cx={x(e.year)} cy={pad.t} r="11" fill="#04060c" stroke="#ff7aa8" />
            <text
              x={x(e.year)}
              y={pad.t + 5}
              text-anchor="middle"
              fill="#ff9dc0"
              font-size="13"
              font-weight="700"
            >
              {i + 1}
            </text>
          </g>
        ))}
        <path d={past} stroke="#ffb547" stroke-width="3" fill="none"></path>
        <path
          d={future}
          stroke="#ffb547"
          stroke-width="2"
          stroke-dasharray="6 6"
          fill="none"
          opacity="0.6"
        ></path>
        <circle cx={x(nowYear)} cy={yv(power(nowYear))} r="6" fill="#ffb547" class="now"></circle>
      </svg>
      <figcaption class="muted small">{p.modelNote}</figcaption>
    </figure>
  </div>
</section>

<style>
  .grid {
    display: grid;
    gap: 2rem;
    align-items: center;
  }
  @media (min-width: 960px) {
    .grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
    }
  }
  figure {
    margin: 0;
  }
  svg {
    width: 100%;
    height: auto;
    font-family: var(--font-body);
  }
  .now {
    animation: now-pulse 2s ease-in-out infinite;
    transform-box: fill-box;
    transform-origin: center;
  }
  @keyframes now-pulse {
    50% {
      transform: scale(1.5);
      opacity: 0.6;
    }
  }
  .events {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.5rem;
  }
  .events li {
    display: flex;
    align-items: center;
    gap: 0.7rem;
  }
  .events .mono {
    color: var(--accent);
  }
  .marker {
    display: inline-grid;
    place-items: center;
    flex: none;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    border: 1px solid #ff7aa8;
    color: #ff9dc0;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
  }
  .small {
    font-size: 0.85rem;
    margin-top: 0.75rem;
  }
  @media (max-width: 600px) {
    .tick-minor {
      display: none;
    }
  }
</style>
