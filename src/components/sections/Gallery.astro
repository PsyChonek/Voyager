---
import Picture from '~/components/Picture.astro';
import images from '~/data/images.json';
import { useDict, formatDate, type Locale } from '~/i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useDict(locale);
const g = t.gallery;
const skip = new Set(['pale-blue-dot-1990', 'pale-blue-dot-2020', 'golden-record-cover']);
const items = images.filter((i) => !skip.has(i.slug));
const when = (d: string) =>
  formatDate(
    locale,
    new Date(`${d.length === 7 ? `${d}-15` : d}T12:00:00Z`),
    d.length === 7 ? { day: undefined } : {},
  );
---

<section id="gallery" class="section" aria-labelledby="gallery-title">
  <div class="container">
    <h2 id="gallery-title">{g.title}</h2>
    <p class="lead">{g.intro}</p>

    <div class="compare-wrap">
      <div>
        <h3>{g.compareTitle}</h3>
        <p class="muted">{g.compareBody}</p>
      </div>
      <div class="compare" style="--pos: 50%">
        <Picture
          slug="pale-blue-dot-2020"
          locale={locale}
          sizes="(max-width: 700px) 100vw, 520px"
          class="layer after"
        />
        <Picture
          slug="pale-blue-dot-1990"
          locale={locale}
          sizes="(max-width: 700px) 100vw, 520px"
          class="layer before"
        />
        <span class="tag tag-l mono" aria-hidden="true">
          {g.before}
        </span>
        <span class="tag tag-r mono" aria-hidden="true">
          {g.after}
        </span>
        <span class="divider" aria-hidden="true"></span>
        <input type="range" min="0" max="100" value="50" aria-label={g.compareLabel} />
      </div>
    </div>

    <ul class="grid">
      {items.map((img) => (
        <li>
          <figure>
            <button type="button" class="open" data-slug={img.slug} aria-label={img.title[locale]}>
              <Picture
                slug={img.slug}
                locale={locale}
                sizes="(max-width: 600px) 100vw, (max-width: 1000px) 50vw, 380px"
              />
            </button>
            <figcaption>
              <strong>{img.title[locale]}</strong>
              <span class="muted mono small">
                {when(img.date)}, {img.craft === 'V1' ? 'Voyager 1' : 'Voyager 2'}
              </span>
              <span class="muted small">{img.caption[locale]}</span>
              <a class="small" href={img.sourceUrl} rel="noopener" target="_blank">
                {img.pia}, {img.credit}
              </a>
            </figcaption>
          </figure>
        </li>
      ))}
    </ul>
  </div>

  <dialog class="lightbox" aria-label={g.title}>
    <form method="dialog">
      <button class="close btn" aria-label={g.close}>
        x
      </button>
    </form>
    <img alt="" />
  </dialog>
</section>

<script>
  const compare = document.querySelector<HTMLElement>('#gallery .compare');
  const range = compare?.querySelector<HTMLInputElement>('input');
  range?.addEventListener('input', () => compare!.style.setProperty('--pos', `${range.value}%`));

  const dialog = document.querySelector<HTMLDialogElement>('#gallery .lightbox');
  const big = dialog?.querySelector('img');
  document.querySelectorAll<HTMLButtonElement>('#gallery .open').forEach((btn) => {
    btn.addEventListener('click', () => {
      if (!dialog || !big) return;
      const img = btn.querySelector('img');
      big.src = `/images/${btn.dataset.slug}-1600.webp`;
      big.alt = img?.alt ?? '';
      dialog.showModal();
    });
  });
  dialog?.addEventListener('click', (e) => {
    if (e.target === dialog) dialog.close();
  });
</script>

<style>
  .compare-wrap {
    display: grid;
    gap: 1.5rem;
    align-items: center;
    margin-block: 2.5rem 3.5rem;
  }
  @media (min-width: 900px) {
    .compare-wrap {
      grid-template-columns: 1fr minmax(0, 520px);
    }
  }
  .compare {
    position: relative;
    aspect-ratio: 1200 / 1626;
    max-height: 80svh;
    border-radius: var(--radius);
    overflow: hidden;
    background: #000;
  }
  .compare :global(.layer),
  .compare :global(.layer img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .compare :global(.before) {
    clip-path: inset(0 calc(100% - var(--pos)) 0 0);
  }
  .divider {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--pos);
    width: 2px;
    background: var(--accent);
    pointer-events: none;
  }
  .tag {
    position: absolute;
    top: 12px;
    padding: 0.2em 0.6em;
    border-radius: 999px;
    background: rgb(4 6 12 / 0.7);
    font-size: 0.85rem;
  }
  .tag-l {
    left: 12px;
  }
  .tag-r {
    right: 12px;
  }
  .compare input {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    cursor: ew-resize;
    margin: 0;
  }
  .compare:has(input:focus-visible) {
    outline: 3px solid var(--focus);
    outline-offset: 3px;
  }
  .grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 1.5rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
  }
  figure {
    margin: 0;
  }
  .open {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: #000;
    border-radius: var(--radius);
    overflow: hidden;
    cursor: zoom-in;
    aspect-ratio: 4 / 3;
  }
  .open :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s;
  }
  .open:hover :global(img) {
    transform: scale(1.04);
  }
  figcaption {
    display: grid;
    gap: 0.25rem;
    padding-top: 0.75rem;
  }
  .small {
    font-size: 0.85rem;
  }
  .lightbox {
    max-width: min(96vw, 1400px);
    max-height: 94svh;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: #000;
  }
  .lightbox::backdrop {
    background: rgb(0 0 0 / 0.85);
  }
  .lightbox img {
    max-height: 90svh;
    width: auto;
    margin-inline: auto;
  }
  .close {
    position: absolute;
    top: 8px;
    right: 8px;
    background: rgb(4 6 12 / 0.8);
  }
</style>
