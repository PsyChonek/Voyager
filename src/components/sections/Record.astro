---
import Picture from '~/components/Picture.astro';
import SectionHead from '~/components/SectionHead.astro';

import { useDict, type Locale } from '~/i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useDict(locale);
const r = t.record;
// Hotspot positions (percent of the photo) for each engraved diagram.
const spots: Record<string, [number, number]> = {
  hydrogen: [33, 24.5],
  pulsar: [67.5, 33],
  image: [35, 56],
  playback: [70.5, 65],
};
---

<section id="record" class="section" aria-labelledby="record-title">
  <div class="container grid">
    <div class="cover" data-reveal="zoom">
      <Picture slug="golden-record-cover" locale={locale} sizes="(max-width: 960px) 100vw, 560px" />
      <div class="spots" role="group" aria-label={r.coverLabel}>
        {r.parts.map((p, i) => (
          <button
            type="button"
            class="spot"
            style={`left:${spots[p.id][0]}%;top:${spots[p.id][1]}%`}
            aria-pressed={i === 0 ? 'true' : 'false'}
            aria-controls="record-detail"
            data-part={p.id}
          >
            <span class="visually-hidden">{p.title}</span>
            <span aria-hidden="true">{i + 1}</span>
          </button>
        ))}
      </div>
    </div>
    <div>
      <SectionHead
        num={6}
        label={t.sections.record}
        id="record-title"
        title={r.title}
        lead={r.intro}
      />
      <div id="record-detail" class="panel" aria-live="polite">
        {r.parts.map((p, i) => (
          <div class="part" data-part={p.id} hidden={i !== 0}>
            <h3>
              <span class="num mono">{i + 1}</span> {p.title}
            </h3>
            <p>{p.body}</p>
          </div>
        ))}
      </div>
      <h3 class="contents-title">{r.contentsTitle}</h3>
      <dl class="stats" data-reveal>
        {r.contents.map((c) => (
          <div>
            <dt class="mono" data-count={c.value}>
              {c.value}
            </dt>
            <dd>{c.label}</dd>
          </div>
        ))}
      </dl>
      <p class="muted small">{r.musicNote}</p>
    </div>
  </div>
  <div class="container more">
    <div class="tabs" data-reveal>
      <div class="tablist" role="tablist" aria-label={r.tabsLabel}>
        {r.tabs.map((tab, i) => (
          <button
            type="button"
            role="tab"
            id={`rtab-${tab.id}`}
            aria-controls={`rpanel-${tab.id}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            tabindex={i === 0 ? 0 : -1}
          >
            {tab.count && <span class="tab-count mono">{tab.count}</span>}
            {tab.title}
          </button>
        ))}
      </div>
      {r.tabs.map((tab, i) => (
        <div
          class="tabpanel panel"
          role="tabpanel"
          id={`rpanel-${tab.id}`}
          aria-labelledby={`rtab-${tab.id}`}
          tabindex="0"
          hidden={i !== 0}
        >
          <p>{tab.body}</p>
          <ul class="chips">
            {tab.items.map((item, k) => (
              <li style={`--k:${k}`}>{item}</li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="cards">
      <article class="panel" data-reveal style="--i:0">
        <h3>{r.makersTitle}</h3>
        <p class="muted">{r.makersBody}</p>
      </article>
      <article class="panel" data-reveal style="--i:1">
        <h3>{r.buildTitle}</h3>
        <ul class="ticks">
          {r.build.map((b) => (
            <li>{b}</li>
          ))}
        </ul>
      </article>
      <article class="panel future" data-reveal style="--i:2">
        <h3>{r.futureTitle}</h3>
        <ul class="dest">
          {r.future.map((f) => (
            <li>
              <strong class={f.craft.endsWith('1') ? 'c-v1' : 'c-v2'}>{f.craft}</strong>
              <span class="muted">{f.text}</span>
            </li>
          ))}
        </ul>
        <p class="quote">{r.saganNote}</p>
      </article>
    </div>
  </div>
</section>

<script>
  const root = document.getElementById('record');
  root?.querySelectorAll<HTMLButtonElement>('.spot').forEach((btn) => {
    btn.addEventListener('click', () => {
      const id = btn.dataset.part;
      root
        .querySelectorAll<HTMLButtonElement>('.spot')
        .forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
      root
        .querySelectorAll<HTMLElement>('.part')
        .forEach((p) => (p.hidden = p.dataset.part !== id));
    });
  });

  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('#record [role="tab"]'));
  const select = (tab: HTMLButtonElement, focus = false) => {
    tabs.forEach((t) => {
      const on = t === tab;
      t.setAttribute('aria-selected', String(on));
      t.tabIndex = on ? 0 : -1;
      const panel = document.getElementById(t.getAttribute('aria-controls')!);
      if (panel) panel.hidden = !on;
    });
    if (focus) tab.focus();
  };
  tabs.forEach((tab, i) => {
    tab.addEventListener('click', () => select(tab));
    tab.addEventListener('keydown', (e) => {
      const dir = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
      if (e.key === 'Home') select(tabs[0], true);
      else if (e.key === 'End') select(tabs[tabs.length - 1], true);
      else if (dir) select(tabs[(i + dir + tabs.length) % tabs.length], true);
      else return;
      e.preventDefault();
    });
  });
</script>

<style>
  .more {
    margin-top: clamp(3rem, 6vw, 5rem);
    display: grid;
    gap: 2rem;
  }
  .tablist {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }
  [role='tab'] {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 48px;
    padding: 0.5rem 1.1rem;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: var(--bg-raised);
    color: var(--muted);
    font-family: var(--font-display);
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
    transition: 0.3s var(--ease-out);
  }
  [role='tab']:hover {
    color: var(--text);
    border-color: rgb(255 181 71 / 0.5);
  }
  [role='tab'][aria-selected='true'] {
    background: var(--grad-gold);
    color: #1a0f00;
    border-color: transparent;
  }
  .tab-count {
    font-size: 0.8rem;
    opacity: 0.8;
  }
  .tabpanel p {
    max-width: 70ch;
  }
  .chips {
    list-style: none;
    padding: 0;
    margin: 1rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .chips li {
    padding: 0.45rem 0.9rem;
    border-radius: 999px;
    border: 1px solid rgb(255 181 71 / 0.25);
    background: rgb(255 181 71 / 0.06);
    font-size: 0.92rem;
    animation: chip-in 0.5s var(--ease-out) both;
    animation-delay: calc(var(--k) * 45ms);
  }
  @keyframes chip-in {
    from {
      opacity: 0;
      transform: translateY(8px) scale(0.96);
    }
  }
  .cards {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
    align-items: start;
  }
  .ticks {
    padding-left: 1.1rem;
    margin: 0;
    display: grid;
    gap: 0.5rem;
    color: var(--muted);
  }
  .ticks li::marker {
    color: var(--accent);
  }
  .dest {
    list-style: none;
    padding: 0;
    margin: 0 0 1rem;
    display: grid;
    gap: 0.75rem;
  }
  .dest li {
    display: grid;
    gap: 0.15rem;
  }
  .quote {
    margin: 0;
    padding-left: 0.9rem;
    border-left: 3px solid var(--accent);
    font-style: italic;
  }

  .grid {
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }
  @media (min-width: 960px) {
    .grid {
      grid-template-columns: minmax(0, 560px) 1fr;
    }
  }
  .cover {
    position: relative;
  }
  .cover :global(img) {
    width: 100%;
    height: auto;
    border-radius: var(--radius);
  }
  .spots {
    position: absolute;
    inset: 0;
  }
  .spot {
    position: absolute;
    transform: translate(-50%, -50%);
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 2px solid var(--accent);
    background: rgb(4 6 12 / 0.75);
    color: var(--accent);
    font-family: var(--font-mono);
    font-weight: 700;
    cursor: pointer;
  }
  .spot {
    transition: transform 0.3s var(--ease-out);
  }
  .spot:hover {
    transform: translate(-50%, -50%) scale(1.12);
  }
  .spot::after {
    content: '';
    position: absolute;
    inset: -2px;
    border-radius: 50%;
    border: 2px solid var(--accent);
    animation: spot-ping 2.4s var(--ease-out) infinite;
    pointer-events: none;
  }
  @keyframes spot-ping {
    to {
      transform: scale(1.9);
      opacity: 0;
    }
  }
  .spot[aria-pressed='true'] {
    background: var(--accent);
    color: var(--bg);
  }
  .cover :global(img) {
    box-shadow: 0 40px 90px -30px rgb(255 160 60 / 0.35);
  }
  .num {
    color: var(--accent);
    margin-right: 0.3rem;
  }
  .contents-title {
    margin-top: 2rem;
  }
  .stats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin: 0;
  }
  @media (min-width: 600px) {
    .stats {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  .stats dt {
    font-size: 2rem;
    color: var(--accent);
  }
  .stats dd {
    margin: 0;
    color: var(--muted);
    font-size: 0.9rem;
  }
  .small {
    font-size: 0.85rem;
    margin-top: 1rem;
  }
</style>
