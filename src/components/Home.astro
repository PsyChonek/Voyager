---
import Base from '~/layouts/Base.astro';
import Hero from './sections/Hero.astro';
import Journey from './sections/Journey.astro';
import Ticker from './sections/Ticker.astro';
import Spacecraft from './sections/Spacecraft.astro';
import DataTeaser from './sections/DataTeaser.astro';
import Signal from './sections/Signal.astro';
import Power from './sections/Power.astro';
import Record from './sections/Record.astro';
import Gallery from './sections/Gallery.astro';
import { useDict, type Locale } from '~/i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useDict(locale);
const site = Astro.site!;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: t.meta.homeTitle,
    description: t.meta.homeDescription,
    inLanguage: locale,
    image: new URL(`/og-${locale}.jpg`, site).href,
    about: [
      { '@type': 'Thing', name: 'Voyager 1', sameAs: 'https://en.wikipedia.org/wiki/Voyager_1' },
      { '@type': 'Thing', name: 'Voyager 2', sameAs: 'https://en.wikipedia.org/wiki/Voyager_2' },
    ],
    author: { '@type': 'Person', name: 'Daniel Vazac', url: 'https://vazac.dev' },
  },
];
---

<Base
  locale={locale}
  route="home"
  title={t.meta.homeTitle}
  description={t.meta.homeDescription}
  jsonLd={jsonLd}
>
  <Hero locale={locale} />
  <Ticker locale={locale} />
  <Journey locale={locale} />
  <Spacecraft locale={locale} />
  <DataTeaser locale={locale} />
  <Signal locale={locale} />
  <Power locale={locale} />
  <Record locale={locale} />
  <Gallery locale={locale} />
</Base>
